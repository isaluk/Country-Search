{
  "name": "country-search",
  "version": "1.0.0",
  "description": "Live country search with request cancellation in TypeScript",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "serve public",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "deploy": "npm test && npm run build && gh-pages -d public --nojekyll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaluk/Country-Search.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/isaluk/Country-Search/issues"
  },
  "homepage": "https://github.com/isaluk/Country-Search#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{html,css,json,md}": "prettier --write"
  }
}
